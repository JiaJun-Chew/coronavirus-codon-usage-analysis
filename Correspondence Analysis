# Load libraries
library(readxl)
library(dplyr)
library(FactoMineR)
library(ggplot2)
library(tidyr)

# Load data
df <- read_excel("D:/Degree (MMU)/Manuscript/Submission/S1 Table.xlsx")

# Select RSCU columns
rscu_cols <- grep("^[AUCG]{3}$", names(df), value = TRUE)

# Exclude AUG, UGG and stop codons
exclude_codons <- c("AUG", "UGG", "UAA", "UAG", "UGA")
rscu_cols <- setdiff(rscu_cols, exclude_codons)

# Extract RSCU matrix
rscu_data <- df %>%
  select(all_of(rscu_cols))

rscu_data[] <- lapply(rscu_data, as.numeric)

# Correspondence Analysis
coa_res <- CA(rscu_data, graph = FALSE)

# Extract genome coordinates
ind_coords <- as.data.frame(coa_res$row$coord[,1:2])

colnames(ind_coords) <- c("Dim1", "Dim2")

ind_coords$Organism <- df$Organism
ind_coords$Genus <- df$Genus
ind_coords$Host <- df$Host

# Explained variance
var1 <- round(coa_res$eig[1,2], 1)
var2 <- round(coa_res$eig[2,2], 1)


# Codon contributions
codon_contrib <- as.data.frame(coa_res$col$contrib)

# Top codons for Dimension 1
top_dim1 <- codon_contrib %>%
  arrange(desc(Dim.1)) %>%
  select(Dim.1) %>%
  head(10)

top_dim1$Codon <- rownames(top_dim1)

# Top codons for Dimension 2
top_dim2 <- codon_contrib %>%
  arrange(desc(Dim.2)) %>%
  select(Dim.2) %>%
  head(10)

top_dim2$Codon <- rownames(top_dim2)

